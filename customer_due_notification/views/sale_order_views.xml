<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_due_notification" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.due.notification</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="has_overdue_amount" invisible="1"/>
                <field name="overdue_amount" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert" invisible="not has_overdue_amount">
                    <span groups="customer_due_notification.group_overdue_amount_viewer">
                        This customer has an Outstanding overdue amount of <field name="overdue_amount" widget="monetary" readonly="1" class="fw-bold"/>.
                    </span>
                    <span groups="!customer_due_notification.group_overdue_amount_viewer">
                        This customer have a Outstandind overdue amount.
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
